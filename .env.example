# Скопируйте этот файл в .env и заполните нужное. Без .env демо работает на правилах.

# Движок анализа: auto (Claude, если задан ключ; иначе правила) | rules | claude
ENGINE=auto

# Ключ Anthropic API: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и глубина рассуждений (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# 1 = разобрать 26 демо-обращений через LLM при первом запуске (платные запросы)
SEED_WITH_LLM=0

# Сколько минут сотрудник тратит на ручной разбор одного обращения (для оценки экономии)
MANUAL_MINUTES_PER_MESSAGE=4

# --- Интеграции (все необязательные) ---
# Любая система с входящим вебхуком: n8n, Make, свой сервис
OUTGOING_WEBHOOK_URL=
# Входящий вебхук Битрикс24 вида https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX24_WEBHOOK_URL=
# Уведомления о горячих лидах в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
